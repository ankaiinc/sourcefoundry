{
  "name": "sourcefoundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone multi-tenant source ingestion service",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "api": "node dist/src/server.js",
    "worker": "node dist/src/worker.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
