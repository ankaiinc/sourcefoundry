# Copy this file to .env before running Docker Compose.
# Replace this value with a long random token before exposing the service.
SOURCEFOUNDRY_API_TOKEN=replace-with-a-long-random-token

# Docker Compose database. For a host-installed Postgres, change postgres to localhost.
SOURCEFOUNDRY_DATABASE_URL=postgresql://sourcefoundry:sourcefoundry@postgres:5432/sourcefoundry?sslmode=disable
SOURCEFOUNDRY_PUBLIC_BASE_URL=http://localhost:8080

# Optional search providers. Configure only providers you are authorized to use.
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Optional, for a private CA used by a remote PostgreSQL provider.
SOURCEFOUNDRY_DATABASE_CA_FILE=
